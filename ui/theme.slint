export enum ThemeName {
    linux,
    yaru,
}

// Every colour a theme defines. Components never read a palette directly; they
// use the `Theme` tokens below, which follow the selected palette.
struct Palette {
    background: color,
    titlebar: color,
    sidebar: color,
    panel: color,
    field: color,
    address-bar: color,
    surface: color,
    surface-raised: color,
    border: color,
    border-strong: color,
    text: color,
    text-muted: color,
    text-faint: color,
    accent: color,
    accent-hover: color,
    on-accent: color,
    selection: color,
    success: color,
    warning: color,
    danger: color,
    info: color,
    blue: color,
    purple: color,
}

export global Theme {
    in-out property <ThemeName> name: ThemeName.linux;

    // The Linux console's 16-colour VGA palette, combined the way console tools
    // such as Midnight Commander use it: a blue (#0000AA) title bar and
    // selection on black, cyan (#00AAAA) frames, a yellow (#FFFF55) accent with
    // black text, and white / light-grey / dark-grey text for emphasis levels.
    // POST and 4xx use brown (#AA5500) so they don't read as the accent.
    property <Palette> linux: {
        background: #000000,
        titlebar: #0000aa,
        sidebar: #000000,
        panel: #000000,
        field: #000000,
        address-bar: #000000,
        surface: #555555,
        surface-raised: #5555ff,
        border: #555555,
        border-strong: #00aaaa,
        text: #ffffff,
        text-muted: #aaaaaa,
        text-faint: #555555,
        accent: #ffff55,
        accent-hover: #ffffff,
        on-accent: #000000,
        selection: #0000aa,
        success: #55ff55,
        warning: #aa5500,
        danger: #ff5555,
        info: #55ffff,
        blue: #5555ff,
        purple: #ff55ff,
    };

    // Ubuntu Yaru (dark). Base colours are taken from the installed Yaru-dark GTK 4
    // theme: headerbar #222222, window #2c2c2c, views #272727, borders #131313,
    // accent Ubuntu orange #E95420. The method/status hues come from Yaru's accent
    // variants lightened so they stay legible as text on dark surfaces.
    property <Palette> yaru: {
        background: #2c2c2c,
        titlebar: #222222,
        sidebar: #222222,
        panel: #272727,
        field: #1d1d1d,
        address-bar: #181818,
        surface: #333333,
        surface-raised: #3c3c3c,
        border: #1b1b1b,
        border-strong: #131313,
        text: #f7f7f7,
        text-muted: #ffffffb3,
        text-faint: #ffffff80,
        accent: #e95420,
        accent-hover: #ec6d40,
        on-accent: #ffffff,
        selection: #e9542066,
        success: #6cc24a,
        warning: #f99b11,
        danger: #f0607a,
        info: #4fb3b7,
        blue: #4c9df5,
        purple: #a496ec,
    };

    property <Palette> palette: name == ThemeName.yaru ? yaru : linux;

    out property <color> background: palette.background;
    out property <color> titlebar: palette.titlebar;
    out property <color> sidebar: palette.sidebar;
    out property <color> panel: palette.panel;
    out property <color> field: palette.field;
    // The base-URL box sits on this to read as one unit.
    out property <color> address-bar: palette.address-bar;
    out property <color> surface: palette.surface;
    out property <color> surface-raised: palette.surface-raised;
    out property <color> border: palette.border;
    out property <color> border-strong: palette.border-strong;

    out property <color> text: palette.text;
    out property <color> text-muted: palette.text-muted;
    out property <color> text-faint: palette.text-faint;

    out property <color> accent: palette.accent;
    out property <color> accent-hover: palette.accent-hover;
    out property <color> on-accent: palette.on-accent;
    out property <color> selection: palette.selection;

    out property <color> success: palette.success;
    out property <color> warning: palette.warning;
    out property <color> danger: palette.danger;
    out property <color> info: palette.info;
    out property <color> blue: palette.blue;
    out property <color> purple: palette.purple;

    out property <length> radius: 6px;
    out property <length> font-size: 13px;
    out property <length> font-size-small: 11px;
    out property <string> ui-font: "Ubuntu Sans";
    out property <string> mono-font: "JetBrains Mono";

    public pure function method-color(method: string) -> color {
        return method == "GET" ? success
            : method == "POST" ? warning
            : method == "PUT" ? blue
            : method == "PATCH" ? purple
            : method == "DELETE" ? danger
            : info;
    }

    public pure function status-color(code: int) -> color {
        return code >= 500 ? danger : code >= 400 ? warning : code >= 300 ? info : success;
    }
}
